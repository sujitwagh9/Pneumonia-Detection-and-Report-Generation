# Copy to .env and fill in. Only GEMINI_API_KEY is needed for the written report;
# without it the app still classifies and produces Grad-CAM + PDF.
GEMINI_API_KEY=your_api_key_here
# GEMINI_MODEL=gemini-3.5-flash

# Required in production so forms work across restarts / multiple workers.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Pixel scaling fed to the model. 'auto' (default) uses raw 0-255 pixels when the model has
# built-in Rescaling layers (the bundled EfficientNetB0 does), otherwise x/255.
# Other values: raw, rescale, mobilenet_v2
# PREPROCESSING=auto

# MODEL_PATH=x-ray-classification.h5
# RETENTION_MINUTES=60
# UPLOAD_RATE_LIMIT=10 per minute
# FLASK_DEBUG=0
